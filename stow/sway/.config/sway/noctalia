set $secondary          #bec7d3
set $tertiary           #d7bee3
set $error              #ffb4ab
set $surface            #121315
set $on_surface         #e3e2e4
set $on_surface_variant #c3c7cd
set $outline            #8d9197

## Window Colours
# class                 border    backgr.   text                indicator  child_border
