# ==============================================================================
# Mako Custom Notification Architecture Template
# ==============================================================================

# --- Core Dimensions and Positioning ---
max-visible=5
output=DP-1
anchor=top-right
margin=20

# --- Geometry Design Rules ---
width=350
height=110
border-size=2
border-radius=8
padding=15

# --- Typography & Theme Core Engine ---
# Fixed: Added font size to comply with Pango formatting
font=Liberation Mono 11

# Fixed: Made sure wpgtk variables output clean hex strings
background-color=#0d1937
text-color=#4787B7
border-color=#4787B7

# Fixed: Removed the space between 'source' and the color hex
progress-color=source #4787B7

# --- Functional Timeout Values ---
default-timeout=6000
ignore-timeout=0

[urgency=low]
border-color=#4787B7
default-timeout=4000

[urgency=high]
border-color=#4781B2
text-color=#0d1937
default-timeout=0
