# 1. Font settings
font_family      Geist Mono Regular
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        14.0

include ~/.cache/wal/colors-kitty.conf

foreground #066690
background #01161F

disable_ligatures=yes

# 2. Cursor
cursor_shape     beam
cursor_blink_interval 0.5

# 3. Window layout
window_padding_width 8
hide_window_decorations no

# 4. Background & Opacity
background_opacity 0.95
background_blur    20
