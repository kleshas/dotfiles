* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 14px;
}

window#waybar {
    background-color: @color0};
    color: @color1};
}

/* Base style for the window title */
#window {
    color: @color1;
    background-color: @color0;
    padding: 2px 12px;
    margin: 4px 5px;
    border-radius: 8px;
    border: 1px solid @color5;
}

/* Style when no windows are open */
#window.empty {
    background-color: transparent;
    color: transparent;
    padding: 0;
    margin: 0;
    border: none;
}

button {
    box-shadow: inset 0 -3px transparent;
    border: none;
    border-radius: 0;
}

#workspaces button {
	color: @color1;
    background-color: @color0;
    padding: 2px 12px;
    margin: 4px 5px;
    border-radius: 8px;
    border: 1px solid @color5;
}

#workspaces button:hover {
    background-color: @color3;
    color: @color8;
    font-weight: bold;
}

#workspaces button.focused,
#workspaces button.active {
    background-color: @color0;
    color: @color1;
    font-weight: bold;
}

#workspaces button.urgent {
    background-color: @color12;
    color: @color0;
}

#mode {
    background-color: @color0;
    color: @color1;
    font-weight: bold;
    padding: 2px 10px;
}

/* Synced Capsule Modules */
#clock,
#pulseaudio,
#tray {
    color: @color1;
    background-color: @color0;
    padding: 2px 12px;
    margin: 4px 5px;
    border-radius: 8px;
    border: 1px solid @color5;
}

/* Exact Internal Text Positioning Rules */
#clock label,
#pulseaudio label {
    color: @color1;
    font-weight: bold;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    background-color: @color12;
    border-radius: 4px;
}

/* Tooltip container styling */
tooltip {
  background: rgba(46, 52, 64, 0.95);  /* Nord Dark Base with 95% opacity */
  border: 2px solid @color5;          /* Sharp Nord Frost Blue Outline */
  border-radius: 10px;
}

/* Tooltip text styling */
tooltip label {
  color: @color1;
  font-family: "JetBrainsMono Nerd Font";
  font-size: 14px;
}
